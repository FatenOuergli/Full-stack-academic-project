# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/patisserie
# Angular dev server, the only origin allowed by CORS
CLIENT_ORIGIN=http://localhost:4200

# First admin account, created by `npm run seed`
SEED_ADMIN_EMAIL=admin@patisserie.tn
SEED_ADMIN_PASSWORD=ChangeMe2026

# Signs the access tokens (JWT). At least 32 characters, keep it secret.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Access token lifetime (short: it travels with every request)
JWT_ACCESS_TTL=15m
# Refresh token lifetime, kept in an httpOnly cookie
REFRESH_TOKEN_TTL_DAYS=7
