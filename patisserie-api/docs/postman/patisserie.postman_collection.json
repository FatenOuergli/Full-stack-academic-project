            "description": "Saves the access token in the collection variable {{accessToken}}. Postman keeps the refreshToken cookie for the refresh request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"amira.bensalah@example.tn\",\n  \"password\": \"Client2026\"\n}",
              "options": {
                "raw": {
