{
  "info": {
    "name": "Pâtisserie Maison API",
    "description": "Requests for the Pâtisserie Maison REST API (traditional Tunisian pâtisserie). All amounts are integers in millimes: 18500 = 18.500 DT.\n\nSelect the environment \"Pâtisserie Maison – local\" before sending requests.\n\nUpdated at the end of every phase.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System (phase 3)",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('API and database are up', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('ok');",
                  "  pm.expect(body.database).to.eql('connected');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness check. Returns 503 with database: disconnected when MongoDB is down."
          }
        },
        {
          "name": "Unknown route returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 in the standard error shape', () => {",
                  "  pm.response.to.have.status(404);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.include.keys('status', 'code', 'message');",
                  "  pm.expect(body.code).to.eql('NOT_FOUND');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/does-not-exist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "does-not-exist"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Malformed JSON returns 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 INVALID_JSON', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().code).to.eql('INVALID_JSON');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"broken\":"
            }
          }
        }
      ]
    },
    {
      "name": "Auth & users (phase 4)",
      "item": [
        {
          "name": "Register a customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created as a customer', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().data.user.role).to.eql('customer');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Uses a new email each time ({{$timestamp}}). The \"role\": \"admin\" field is ignored on purpose: you cannot register as admin.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"leila.{{$timestamp}}@example.tn\",\n  \"password\": \"Makroudh2026\",\n  \"firstName\": \"Leila\",\n  \"lastName\": \"Haddad\",\n  \"phone\": \"+21698765432\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login customer (Amira)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK, token saved in {{accessToken}}', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const { data } = pm.response.json();",
                  "  pm.expect(data.user.role).to.eql('customer');",
                  "  pm.collectionVariables.set('accessToken', data.accessToken);",
                  "});",
                  "pm.test('refresh cookie is httpOnly', () => pm.expect(pm.cookies.has('refreshToken') || pm.response.headers.get('Set-Cookie').includes('HttpOnly')).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
